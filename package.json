{
  "name": "hyperion",
  "displayName": "Hyperion",
  "description": "A model-agnostic intelligence layer for software engineering.",
  "version": "0.0.1",
  "publisher": "hyperion",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:hyperion.openDashboard",
    "onCommand:hyperion.setApiKey",
    "onCommand:hyperion.clearChat",
    "onCommand:hyperion.openSettings",
    "onView:hyperion.chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hyperion.openDashboard",
        "title": "Hyperion: Open Chat"
      },
      {
        "command": "hyperion.setApiKey",
        "title": "Hyperion: Set API Key"
      },
      {
        "command": "hyperion.clearChat",
        "title": "Hyperion: New Chat"
      },
      {
        "command": "hyperion.openSettings",
        "title": "Hyperion: Open Settings"
      }
    ],
    "configuration": {
      "title": "Hyperion",
      "properties": {
        "hyperion.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Hyperion status bar entry."
        },
        "hyperion.apiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for an OpenAI-compatible API. Hyperion appends /chat/completions unless it is already present."
        },
        "hyperion.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model identifier sent to the configured API."
        },
        "hyperion.systemPrompt": {
          "type": "string",
          "default": "You are a helpful software engineering assistant.",
          "description": "System prompt included at the beginning of each chat request."
        },
        "hyperion.requestTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 600,
          "description": "Maximum time in seconds for a chat request."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hyperion",
          "title": "Hyperion",
          "icon": "media/hyperion.svg"
        }
      ]
    },
    "views": {
      "hyperion": [
        {
          "id": "hyperion.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "precompile": "node -e \"require('node:fs').rmSync(require('node:path').join(process.cwd(), 'out'), { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
